{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "dev-7-11-adf"
		},
		"adls_link_serivce_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'adls_link_serivce'"
		},
		"databricks_link_7_11_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'databricks_link_7_11'"
		},
		"adls_link_serivce_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://devadls711.dfs.core.windows.net/"
		},
		"databricks_link_7_11_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1019-022056-nps05z1e"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "dev-7-11-adf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"adls_link_serivce_accountKey": {
						"value": "[parameters('adls_link_serivce_accountKey')]"
					},
					"databricks_link_7_11_accessToken": {
						"value": "[parameters('databricks_link_7_11_accessToken')]"
					},
					"adls_link_serivce_properties_typeProperties_url": {
						"value": "[parameters('adls_link_serivce_properties_typeProperties_url')]"
					},
					"databricks_link_7_11_properties_typeProperties_existingClusterId": {
						"value": "[parameters('databricks_link_7_11_properties_typeProperties_existingClusterId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}